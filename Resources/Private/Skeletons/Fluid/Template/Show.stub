<html
    data-namespace-typo3-fluid="true"
    xmlns:f="http://typo3.org/ns/TYPO3/CMS/Fluid/ViewHelpers"
    xmlns:foundation="http://typo3.org/ns/PSBits/Foundation/ViewHelpers">
    <h1>{{ labelExpression }}</h1>

    <div class="d-flex gap-2 mt-3">
        <f:link.action
            action="list"
            class="btn btn-secondary">
            <foundation:translate id="back" />
        </f:link.action>
        {{ editLink }}
        {{ deleteForm }}
    </div>
</html>
