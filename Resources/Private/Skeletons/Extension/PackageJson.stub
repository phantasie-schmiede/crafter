{
  "name": "{{ repositoryName }}",
  "version": "1.0.0",
  "description": "{{ description }}",
  "scripts": {
    {{ packageScripts }}
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ gitHubRepository }}.git"
  },
  "license": "{{ license }}",
  "bugs": {
    "url": "https://github.com/{{ gitHubRepository }}/issues"
  },
  "homepage": "https://github.com/{{ gitHubRepository }}#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    {{ packageDevDependencies }}
  }
}