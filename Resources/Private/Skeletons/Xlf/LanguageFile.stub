<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<xliff version="1.0">
    <file
        datatype="plaintext"
        date="{{ date }}"
        original="messages"
        product-name="{{ extensionKey }}"
        source-language="{{ defaultLanguage }}"{{ targetLanguageAttribute }}>
        <body>
            {{ transUnits }}
        </body>
    </file>
</xliff>
