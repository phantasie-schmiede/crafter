{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSBits\\Crafter\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSBits\\Crafter\\Tests\\": "Tests/",
            "TYPO3\\CMS\\Core\\Tests\\": ".Build/vendor/typo3/cms-core/Tests"
        }
    },
    "bin": [
        "bin/crafter"
    ],
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "description": "Code and file generator for TYPO3 extensions",
    "extra": {
        "typo3/cms": {
            "extension-key": "crafter",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "code-generator",
        "dev",
        "extension",
        "scaffolding",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psbits/crafter",
    "require": {
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "nikic/php-parser": "^5.0",
        "php": "^8.3",
        "psbits/foundation": "^4.2.2",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "typo3/cms-core": "^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "psbits/qa": "@dev",
        "roave/security-advisories": "dev-latest",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
        "typo3/testing-framework": "^9.5"
    },
    "scripts": {
        "analyze:php": "phpstan analyse --configuration=Build/Quality/phpstan.neon.dist --no-progress",
        "audit:composer": "composer audit --abandoned=report",
        "fix:all": [
            "@fix:classes",
            "@fix:htmlxml",
            "@fix:php"
        ],
        "fix:classes": "npm run fix:classes",
        "fix:htmlxml": "npm run fix:htmlxml",
        "fix:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --verbose",
        "lint:all": [
            "@analyze:php",
            "composer audit --abandoned=report || echo 'Warning: composer audit reported findings - run \"composer audit\" for details'",
            "@lint:classes",
            "@lint:htmlxml",
            "@lint:php",
            "@lint:yaml",
            "@validate:composer"
        ],
        "lint:classes": "npm run lint:classes",
        "lint:htmlxml": "npm run lint:htmlxml",
        "lint:php": "php-cs-fixer fix --config=Build/Quality/.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "lint:yaml": "yamllint -c .Build/vendor/psbits/qa/Resources/Quality/yamllint.yml Build/Quality Configuration",
        "post-install-cmd": [
            "npm install",
            ".Build/bin/qa link"
        ],
        "post-update-cmd": [
            ".Build/bin/qa link"
        ],
        "qa": [
            "@fix:all",
            "@lint:all",
            "@test:all"
        ],
        "test:all": [
            "@test:unit"
        ],
        "test:coverage": "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runCoverage.sh",
        "test:coverage:update-baseline": "sh .Build/vendor/psbits/qa/Resources/Testing/Scripts/runCoverage.sh --update-baseline",
        "test:unit": [
            "php .Build/vendor/psbits/qa/Resources/Testing/renderPhpunitXml.php unit",
            "php -d memory_limit=1G .Build/bin/phpunit -c .Build/phpunit/UnitTests.xml"
        ],
        "test:unit:update-fixtures": [
            "php .Build/vendor/psbits/qa/Resources/Testing/renderPhpunitXml.php unit",
            "CRAFTER_UPDATE_FIXTURES=1 php -d memory_limit=1G .Build/bin/phpunit -c .Build/phpunit/UnitTests.xml"
        ],
        "validate:composer": "composer validate --no-check-publish"
    },
    "type": "typo3-cms-extension"
}
